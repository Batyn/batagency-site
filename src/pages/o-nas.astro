---
// Страница «О нас» (Figma Final, секция About: без фото 320:3827 / 320:3918, с фото 320:4024 / 320:4119).
// Вариант Batın ещё не выбрал: по умолчанию без фото, с фото — по адресу /o-nas/?photo=1 (только для сверки).
// Тексты — content/site-texts.md, раздел 5; Саша их перепишет (задачи 21, 22).
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Brands from '../components/Brands.astro';
import Consult from '../components/Consult.astro';
import Footer from '../components/Footer.astro';
---
<Base title="О нас — Bat Agency" description="Кто мы: команда с опытом в маркетинге и PR брендинговых агентств, медиа и моды. С кем мы работали.">
  <Header current="o-nas" />
  <main>
    <Breadcrumbs current="О нас" />
    <div class="ab wrap">
      <div class="row">
        <div class="col-main">
          <h1 class="t-h-lg">О нас</h1>
          <div class="ab-body">
            <p class="t-body-lg ab-p1">Рассказываем о <span class="nowrap">дизайн‑ и</span> digital-агентствах, их людях и проектах так, чтобы ими восхищались, а к агентству приходили новые клиенты. Ваша команда тратит время на проекты, о себе за неё рассказываем мы.</p>
            <p class="t-body-lg ab-p2">Мы отвечали за маркетинг и PR брендингового агентства и подавали его проекты на ключевые премии. Вели соцсети журналов, универмагов, фестивалей и театра, готовили тендеры для креативных агентств, делали спецпроекты с художниками и музыкантами. Работаем вдвоём. Если задаче нужна узкая экспертиза, подключаем подрядчика.</p>
            <p class="t-hint ab-note">текст пишет Саша</p>
            <figure class="ab-photo" aria-label="Фото команды (заглушка)">
              <figcaption><span>Фото команды</span><span>Автор и права — уточнить (задача 25)</span></figcaption>
            </figure>
          </div>
        </div>
      </div>
    </div>
    <div class="wrap"><div class="section-rule"></div></div>
    <div class="ab-brands wrap"><Brands page /></div>
    <Consult page />
  </main>
  <Footer />
</Base>

<script is:inline>
  if (new URLSearchParams(location.search).get('photo') === '1') document.documentElement.classList.add('about-photo');
</script>

<style>
  .ab { padding-top: 3.5rem; padding-bottom: 6rem; }
  .ab-body {
    display: grid; grid-template-columns: minmax(0, 648fr) minmax(0, 312fr); column-gap: 1.5rem; row-gap: 1.5rem;
    margin-top: 1.75rem; align-items: start;
  }
  .ab-p1, .ab-p2, .ab-note { grid-column: 1; }
  .ab-photo { display: none; }
  :global(html.about-photo) .ab-photo {
    grid-column: 2; grid-row: 1 / span 3;
    display: flex; flex-direction: column; justify-content: flex-end;
    height: 24.375rem; padding: 1rem; margin: 0;
    background: var(--ph); border-radius: var(--r-md);
  }
  .ab-photo figcaption { display: flex; flex-direction: column; gap: 0.375rem; font: 400 0.8125rem/1.45 var(--font); color: var(--grey); }
  .ab-brands { padding-top: 1.75rem; padding-bottom: var(--section-bottom); }

  @media (max-width: 760px) {
    .ab { padding-top: 2rem; padding-bottom: 2rem; }
    .ab-body { grid-template-columns: 1fr; margin-top: 1.25rem; row-gap: 1.25rem; }
    :global(html.about-photo) .ab-photo { grid-column: 1; grid-row: 2; height: 16.25rem; }
    :global(html.about-photo) .ab-p2 { grid-row: 3; }
    :global(html.about-photo) .ab-note { grid-row: 4; }
    .ab-brands { padding-top: 2rem; padding-bottom: 0; }
  }
</style>
