---
// Страница «О нас» (Figma Final, секция About: десктоп 588:9348, телефон 588:9388). Тексты — content/site-texts.md, раздел 5.
// Блок «Команда»: фото пока заглушки «Фото — скоро»; имена — исключение из правила «имён на сайте нет» (RULES.md v16, Batın 2026-10-20).
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Brands from '../components/Brands.astro';
import Footer from '../components/Footer.astro';

const TEAM = [
  {
    name: 'Батын Эр',
    role: 'Маркетинг, PR, digital',
    bio: 'Больше 8 лет в маркетинге и коммуникациях: агентский PR, профессиональные премии, кейсы и отраслевые медиа, digital-аналитика и развитие сайтов. Говорю с дизайнерами на одном языке, умею управлять командами и проектами. В свободное время снимаю на Fujifilm турецких рыбаков: рыбаки к камере уже привыкли, рыба пока нет.',
  },
  {
    name: 'Саша Эр',
    role: 'Креатив, SMM, редактура, продюсирование',
    bio: 'Больше 12 лет в коммуникациях, глянце, моде и культуре. Разрабатываю стратегии и креативные концепции, работаю с контентом и визуальным языком брендов, продюсирую съёмки и спецпроекты, собираю команды. Развиваю собственный музыкальный проект. С одинаковой увлечённостью напишу о золотых трусах Ирины Шейк и о налогах при покупке суперъяхты.',
  },
];
---
<Base title="О нас — Bat Agency" description="bat — независимое агентство маркетинга и коммуникаций: команда с опытом в медиа, моде, брендинге и digital-агентствах. Кто мы и где работали.">
  <Header current="o-nas" />
  <main>
    <Breadcrumbs current="О нас" />
    <div class="ab wrap">
      <div class="row">
        <div class="col-main">
          <h1 class="t-h-lg">О нас</h1>
          <div class="ab-body">
            <p class="t-lead">bat — независимое адаптивное агентство маркетинга и коммуникаций.</p>
            <p class="t-body-lg">Мы небольшая команда с большим профессиональным опытом и возможностью масштабироваться под задачи проекта. За нашими плечами — годы работы в медиа, моде, брендинге, недвижимости и культурных проектах, а также внутри креативных и <span class="nowrap">digital-агентств</span>.</p>
            <p class="t-body-lg">Разрабатывали стратегии, занимались PR, развивали социальные сети, создавали контент и продюсировали проекты. Умеем работать с данными, анализировать поведение пользователей, проверять гипотезы и находить возможности для улучшения сайтов и коммуникаций.</p>
            <p class="t-body-lg">Этот опыт мы объединили в собственном founder-led агентстве, где лично ведём проекты и отвечаем за результат. Хорошо понимаем специфику разных индустрий и умеем подбирать инструменты под задачи бизнеса.</p>
          </div>
        </div>
      </div>
    </div>

    <div class="wrap"><div class="section-rule"></div></div>
    <section class="team wrap" aria-labelledby="team-h">
      <h2 class="team-label t-label-md" id="team-h">Команда</h2>
      <ul class="team-list">
        {TEAM.map((p) => (
          <li class="person">
            <figure class="person-photo" aria-label={`Фото: ${p.name}, скоро`}>
              <figcaption class="t-hint">Фото — скоро</figcaption>
            </figure>
            <div class="person-text">
              <div class="person-head">
                <h3 class="person-name">{p.name}</h3>
                <p class="person-role t-caption">{p.role}</p>
              </div>
              <p class="t-body-lg">{p.bio}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <div class="wrap"><div class="section-rule"></div></div>
    <div class="ab-brands wrap"><Brands page /></div>
  </main>
  <Footer />
</Base>

<style>
  .ab { padding-top: var(--s-6xl); padding-bottom: var(--section-top); }
  .ab-body { margin-top: var(--s-3xl); }
  .ab-body > * + * { margin-top: var(--s-2xl); }

  .team {
    display: grid; grid-template-columns: var(--col-3) minmax(0, 1fr); column-gap: var(--col-gap);
    padding-top: var(--s-3xl); padding-bottom: var(--section-top);
  }
  .team-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--col-gap); list-style: none; margin: 0; padding: 0; }
  .person { display: flex; flex-direction: column; gap: var(--s-2xl); }
  .person-photo {
    display: flex; align-items: flex-end; margin: 0; padding: var(--s-lg);
    aspect-ratio: 4 / 5; background: var(--ph); border-radius: var(--r-md);
  }
  .person-text { display: flex; flex-direction: column; gap: var(--s-md); }
  .person-head { display: flex; flex-direction: column; gap: var(--s-2xs); }
  .person-name { font: 700 1.375rem/1.2 var(--font); }
  .person-role { color: var(--grey); }

  .ab-brands { padding-top: var(--s-3xl); padding-bottom: var(--section-bottom); }

  @media (max-width: 760px) {
    .ab { padding-top: var(--s-4xl); padding-bottom: var(--section-top); }
    .ab-body { margin-top: var(--s-xl); }
    .ab-body > * + * { margin-top: var(--s-xl); }
    .team { grid-template-columns: minmax(0, 1fr); row-gap: var(--s-lg); padding-top: var(--s-4xl); }
    .team-list { grid-template-columns: minmax(0, 1fr); row-gap: var(--s-5xl); }
    .person { gap: var(--s-xl); }
    .person-name { font-size: 1.25rem; line-height: 1.04; letter-spacing: -0.01em; }
    .team-label { font: 500 1.0625rem/1.2 var(--font); }
    .ab-brands { padding-top: var(--s-4xl); }
  }
</style>
