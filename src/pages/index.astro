---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Intro from '../components/Intro.astro';
import Services from '../components/Services.astro';
import Plan from '../components/Plan.astro';
import Process from '../components/Process.astro';
import Consult from '../components/Consult.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="Маркетинг и PR для дизайн- и digital-агентств — Bat Agency"
  description="Пишем кейсы и заявки на премии, ведём соцсети и рассылку, готовим спикеров и вебинары для дизайн- и digital-агентств. Бесплатная консультация."
>
  <Hero variant="b" />
  <main>
    <Intro variant="b" />
    <Services />
    <Plan />
    <Process />
    <Consult />
    <Faq />
  </main>
  <Footer />
</Base>
