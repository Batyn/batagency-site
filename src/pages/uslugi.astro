---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PageTitle from '../components/PageTitle.astro';
import ServiceAccordion from '../components/ServiceAccordion.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="Услуги — Bat Agency"
  description="14 услуг для дизайн- и digital-агентств: PR-стратегия, кейсы, премии, статьи, соцсети, рассылка и другие. Что входит в каждую и как мы работаем."
>
  <Header current="uslugi" />
  <main>
    <Breadcrumbs current="Услуги" />
    <PageTitle title="Услуги">
      <p class="t-body-lg measure">Можем взять на себя маркетинг агентства целиком или подключиться к отдельным задачам, усилив вашу команду необходимой экспертизой.</p>
      <p class="t-body-lg measure">Для долгосрочного сотрудничества <a class="ul" href="/#plan">составим план на полгода</a> с понятными приоритетами, сроками и бюджетом.</p>
    </PageTitle>
    <ServiceAccordion />
  </main>
  <Footer />
</Base>

<style>
  .ul { text-decoration: underline; text-underline-offset: 0.25rem; text-decoration-thickness: 1px; }
</style>
