---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PageTitle from '../components/PageTitle.astro';
import ServiceAccordion from '../components/ServiceAccordion.astro';
import Consult from '../components/Consult.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="Услуги — Bat Agency"
  description="14 услуг для дизайн- и digital-агентств: PR-стратегия, кейсы, премии, статьи, соцсети, рассылка и другие. Что входит в каждую и как мы работаем."
>
  <Header current="uslugi" />
  <main>
    <Breadcrumbs current="Услуги" />
    <PageTitle title="Услуги">
      <p class="t-body-lg measure">Если в агентстве нет своего маркетолога, <a class="ul" href="/#plan">соберём план на полгода</a> и выполним его целиком. Если отдел маркетинга есть, возьмём отдельные задачи. Стоимость называем после консультации.</p>
    </PageTitle>
    <ServiceAccordion />
    <Consult page />
  </main>
  <Footer />
</Base>

<style>
  .ul { text-decoration: underline; text-underline-offset: 0.25rem; text-decoration-thickness: 1px; }
</style>
