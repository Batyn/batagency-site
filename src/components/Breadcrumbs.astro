---
// Хлебные крошки «Главная → …» (caption 15, на телефоне 13).
interface Props { current: string }
const { current } = Astro.props;
---
<nav class="crumbs wrap" aria-label="Хлебные крошки">
  <ol>
    <li><a href="/">Главная</a></li>
    <li aria-hidden="true">→</li>
    <li aria-current="page">{current}</li>
  </ol>
</nav>

<style>
  .crumbs { padding-top: 3rem; }
  ol { display: flex; flex-wrap: wrap; gap: 0.5rem; font: 400 0.9375rem/1.3 var(--font); color: var(--grey); }
  [aria-current] { color: var(--ink); }
  @media (hover: hover) and (pointer: fine) { a:hover { color: var(--ink); } }
  @media (max-width: 760px) {
    .crumbs { padding-top: 1.75rem; }
    a { display: inline-block; padding: 0.875rem 0; margin: -0.875rem 0; }
    ol { font-size: 0.8125rem; }
  }
</style>
