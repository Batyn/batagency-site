---
// «С кем мы работали» — главная и страница «О нас». ONY — только названием, без цифр (RULES.md, раздел 4).
interface Props { page?: boolean }
const { page = false } = Astro.props;
---
<div class:list={['brands', { 'brands--page': page }]}>
  <p class="brands-label t-label-md">С кем мы работали</p>
  <div class="brands-content">
    {!page && <div class="brands-rule"></div>}
    <p class="brands-intro">До Bat Agency мы работали в штате и на фрилансе с этими брендами и медиа:</p>
    <p class="t-lead">ONY · ЦУМ · Glamour · Elle · Time Out · VC.RU · МТС Live · Sotheby's International Realty · Instamart (Kuper) · Amkal · Театр на Таганке · Sound&nbsp;Up</p>
  </div>
</div>

<style>
  .brands { display: grid; grid-template-columns: var(--col-3) minmax(0, 1fr); column-gap: var(--col-gap); }
  .brands-content { display: flex; flex-direction: column; gap: 1rem; }
  .brands-rule { height: 1px; background: var(--ink); }
  .brands-intro { font: 400 1.25rem/1.45 var(--font); color: var(--grey); }
  .brands--page .brands-intro { font-size: 0.9375rem; line-height: 1.3; }

  @media (max-width: 760px) {
    .brands { grid-template-columns: 1fr; row-gap: 0.75rem; }
    .brands-label { font: 400 0.8125rem/1.2 var(--font); }
    .brands-content { gap: 0.75rem; }
    .brands-intro, .brands--page .brands-intro { font-size: 0.9375rem; line-height: 1.45; }
  }
</style>
