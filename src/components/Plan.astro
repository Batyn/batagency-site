---
// «План на полгода» (Figma Final «2а · План на полгода» 278:4690, телефон 278:5112; компоненты Plan/*).
// Десктоп: перетаскивание услуг в календарь. Телефон: вариант C1 — все 14 услуг строками, нажатие на месяц.
// Код календаря — из prototypes/plan-timeline.html; грузится, только когда блок близко к экрану.
import { TELEGRAM_URL, EMAIL } from '../data/site';
import clearSvg from '../assets/icons/clear-arrow.svg?raw';

// стрелка «Очистить» — собственная иконка Batın из Figma (Plan/Icon clear), цвет — от текста
const clearIcon = clearSvg.replace(/fill="#0A0A0A"/g, 'fill="currentColor"').replace(/ style="[^"]*"/, '').replace(/ preserveAspectRatio="none"/, '').replace(/ overflow="visible"/, '');
---
<section class="plan wrap section" id="plan" aria-labelledby="plan-h">
  <div class="section-rule"></div>
  <div class="section-head">
    <div class="row">
      <div class="col-main">
        <h2 class="t-h-lg" id="plan-h">План на полгода</h2>
        <p class="t-body-lg measure">Соберите свой план: <span class="pl-desk">перетащите услуги в календарь</span><span class="pl-phone">отметьте нужные месяцы в календаре</span>. Обсудим его на бесплатной консультации.</p>
      </div>
    </div>
  </div>

  <p class="pl-nojs t-body-lg measure">Соберите план на консультации: расскажите, какие задачи важны, и мы предложим, что и когда делать.</p>

  <div class="pl-app" data-plan-app>
    <div class="pl-palette" id="pl-palette">
      <div class="pl-label">
        <span class="t-label-md">Услуги</span>
        <small class="t-hint" id="pl-hint">Перетащите услугу в календарь или нажмите на неё, а потом на месяц. Плашку можно сдвинуть, растянуть за край или вернуть сюда.</small>
      </div>
      <div class="pl-chips" id="pl-chips"></div>
      <div class="pl-trash" id="pl-trash" aria-hidden="true">Отпустите, чтобы убрать из плана</div>
    </div>

    <div class="pl-caption">
      <h3 class="pl-title" data-title>Пример плана на полгода</h3>
      <button class="pl-restart" type="button" data-restart aria-label="Очистить календарь" title="Очистить календарь" set:html={clearIcon} />
    </div>
    <p class="pl-tap-hint">Нажмите на месяц в строке услуги, чтобы добавить её в план. Нажмите ещё раз, чтобы убрать.</p>
    <div class="pl-grid" id="pl-grid" aria-describedby="pl-keys" data-clear-icon={clearIcon}></div>
    <button class="pl-more" id="pl-more" type="button" aria-controls="pl-grid" aria-expanded="false" hidden><span>Показать ещё</span><svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" /></svg></button>
    <p class="sr" id="pl-keys">Стрелки влево и вправо двигают плашку, с Shift меняют длину, Delete убирает.</p>
  </div>

  <div class="pl-actions">
    <div class="pl-col">
      <div class="pl-buttons">
        <a class="btn btn--lg btn--block-m" id="pl-tg" href={TELEGRAM_URL} target="_blank" rel="noopener">Обсудить план в Telegram</a>
        <button class="btn btn--lg btn--line btn--block-m pl-js" type="button" id="pl-pdf">Скачать PDF</button>
        <a class="pl-mail pl-js" id="pl-mail" href={`mailto:${EMAIL}`}>Отправить на почту</a>
      </div>
      <p class="pl-note t-hint pl-js">Для Telegram скопируем план, останется вставить его в сообщение.</p>
    </div>
  </div>
  <div class="pl-toast" id="pl-toast" role="status" aria-live="polite"></div>
  <p class="sr" id="pl-live" aria-live="polite"></p>
</section>

<script>
  // календарь грузится, когда до блока осталось меньше экрана (как client:visible)
  const app = document.getElementById('plan')!;
  const load = () => import('../scripts/plan').then((m) => m.initPlan());
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { io.disconnect(); load(); } }, { rootMargin: '100% 0px' });
    io.observe(app);
  } else load();
</script>

<style>
  /* Сетка календаря: колонка названий 436 (колонки 1–4) + шесть месяцев по 147.33 */
  .plan {
    --cols: minmax(0, 436fr) repeat(6, minmax(0, 147.333fr));
    --split: minmax(0, 436fr) minmax(0, 884fr);
    /* строка 46, как в Figma; на широком и низком окне — ниже, чтобы заголовок и все 14 строк влезали под шапку
       (Batın 2026-10-09). Не ниже 36: плашке 30 нужен запас */
    --row: clamp(2.25rem, (100svh - var(--header-h) - 2.5rem) / 15, 2.875rem); --gap: 0.375rem;
  }
  .plan .section-head { padding-bottom: 3.5rem; }
  .pl-phone { display: none; }

  /* без JS — только текст и кнопка Telegram */
  .pl-nojs { margin-left: calc(var(--col-3) + var(--col-gap)); margin-bottom: 2rem; }
  .pl-app, .pl-js { display: none; }
  :global(html.js) .pl-nojs { display: none; }
  :global(html.js) .pl-app { display: block; }
  :global(html.js) .pl-js { display: inline-flex; }
  :global(html.js) .pl-note.pl-js { display: block; }

  .pl-palette {
    position: relative;
    display: grid; grid-template-columns: var(--split); align-items: start;
    border-top: 1px solid var(--ink); padding: 1rem 0 2.5rem;
  }
  .pl-label { display: flex; flex-direction: column; gap: 0.375rem; padding: 0.5rem 1.5rem 0 0; }
  .pl-label small { max-width: 18.75rem; }
  .pl-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .pl-trash {
    position: absolute; inset: -1px 0 1rem;
    display: grid; place-items: center;
    border: 1px dashed var(--ink); border-radius: var(--r-sm);
    background: rgba(255, 255, 255, 0.95);
    font: 400 0.9375rem/1.3 var(--font);
    opacity: 0; pointer-events: none;
    transition: opacity 150ms ease, background-color 150ms ease, color 150ms ease;
  }

  .pl-caption { display: none; }
  .pl-tap-hint { display: none; }
  .pl-more {
    display: none; align-items: center; justify-content: center; gap: 0.5rem;
    width: 100%; height: 2.75rem; margin-top: 1rem; padding: 0;
    border: 1px solid var(--ink); border-radius: var(--r-md); background: var(--bg); color: var(--ink);
    font: 400 0.9375rem/1 var(--font); cursor: pointer;
  }
  .pl-more svg { width: 0.75rem; height: 0.75rem; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; transition: transform 200ms var(--ease-out); }
  .pl-more[aria-expanded="true"] svg { transform: rotate(180deg); }

  .pl-actions { display: grid; grid-template-columns: var(--split); margin-top: 2rem; }
  .pl-col { grid-column: 2; }
  .pl-buttons { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1rem; }
  .pl-mail { font: 400 0.9375rem/1.2 var(--font); text-decoration: underline; text-underline-offset: 0.25rem; margin-left: 0.5rem; min-height: 2.75rem; align-items: center; }
  .pl-note { margin-top: 0.875rem; }
  .pl-toast {
    position: fixed; left: 50%; bottom: 1.75rem; z-index: 90;
    transform: translate(-50%, 1rem);
    width: max-content; max-width: calc(100vw - 2.5rem);
    background: var(--ink); color: var(--bg); border-radius: var(--r-md);
    font: 400 0.9375rem/1.4 var(--font); padding: 0.875rem 1.125rem;
    opacity: 0; pointer-events: none;
    transition: opacity 200ms var(--ease-out), transform 200ms var(--ease-out);
  }

  @media (max-width: 760px) {
    .plan { --cols: 0 repeat(6, minmax(0, 1fr)); --split: 1fr; --gap: 2px; }
    .plan .section-head { padding-bottom: 1.75rem; }
    .pl-desk { display: none; }
    .pl-phone { display: inline; }
    .pl-nojs { margin-left: 0; }
    .pl-palette { display: none; }
    .pl-caption { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; margin-bottom: 0.5rem; }
    .pl-tap-hint { display: block; margin-bottom: 0.875rem; font: 400 0.8125rem/1.45 var(--font); color: var(--grey); }
    .pl-more:not([hidden]) { display: flex; }
    .pl-actions { margin-top: 1.5rem; }
    .pl-col { grid-column: 1; }
    .pl-buttons { flex-direction: column; align-items: stretch; gap: 0.75rem; }
    .pl-mail { margin: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pl-trash, .pl-toast { transition: none; }
  }
</style>

<style is:global>
  /* Разметку календаря рисует scripts/plan.ts, поэтому стили — глобальные, с приставкой pl- */
  .plan.is-dragging-bar .pl-trash { opacity: 1; }
  .plan .pl-toast.is-on { opacity: 1; transform: translate(-50%, 0); }
  .pl-trash.is-hot { background: var(--ink); color: var(--bg); border-style: solid; }

  .pl-chip {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.5625rem 0.75rem 0.5625rem 0.5625rem;
    border: 1px solid var(--ink); border-radius: var(--r-sm);
    background: var(--bg); color: var(--ink);
    font: 400 0.875rem/1 var(--font);
    cursor: grab; user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; touch-action: manipulation;
    transition: background-color 150ms ease, color 150ms ease, opacity 150ms ease;
  }
  .pl-chip svg { flex: none; width: 0.5rem; height: 0.875rem; fill: currentColor; opacity: 0.45; }
  @media (hover: hover) and (pointer: fine) { .pl-chip:hover { background: var(--ink); color: var(--bg); } }
  .pl-chip.is-armed { background: var(--ink); color: var(--bg); }
  .pl-chip.is-armed svg { opacity: 0.7; }
  .pl-chip.is-source { opacity: 0.3; }

  .pl-grid { position: relative; isolation: isolate; border-bottom: 1px solid var(--hairline); }
  .pl-row {
    display: grid; grid-template-columns: var(--cols); align-items: center;
    height: var(--row); border-top: 1px solid var(--hairline);
    overflow: hidden; overflow: clip;
    transition: height 240ms var(--ease-out), opacity 240ms var(--ease-out);
  }
  .pl-row > * { grid-row: 1; }
  .pl-row.is-new, .pl-row.is-gone { height: 0; opacity: 0; }
  .pl-name { grid-column: 1; font: 400 0.9375rem/1.3 var(--font); padding-right: 1rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pl-headrow { height: auto; min-height: var(--row); border-top: 0; align-items: end; padding-bottom: 0.75rem; overflow: visible; }
  .pl-headrow .pl-name { display: flex; align-items: center; gap: 0.5rem; overflow: visible; }
  .pl-title { font: 500 1.25rem/1.2 var(--font); letter-spacing: -0.01em; }
  .pl-month { font: 400 0.8125rem/1.2 var(--font); color: var(--grey); }
  .pl-restart {
    flex: none; display: grid; place-items: center;
    width: 2.125rem; height: 2.125rem; margin: -0.5rem 0; padding: 0;
    border: 0; border-radius: var(--r-sm); background: none; color: var(--ink); cursor: pointer;
    transition: background-color 150ms ease, opacity 150ms ease;
  }
  .pl-restart svg { width: 1.25rem; height: 1.25rem; }
  @media (hover: hover) and (pointer: fine) { .pl-restart:hover:not(:disabled) { background: var(--cell-empty); } }
  .pl-restart:disabled { opacity: 0.22; cursor: default; }
  .pl-restart.is-spin svg { animation: pl-spin 550ms var(--ease-out); }
  @keyframes pl-spin { to { transform: rotate(-360deg); } }

  .pl-col-hl { position: absolute; top: 0; bottom: 0; z-index: -1; background: var(--cell-empty); pointer-events: none; opacity: 0; transition: opacity 120ms ease; }
  .pl-col-hl.is-on { opacity: 1; }

  .pl-bar {
    position: relative; z-index: 1;
    height: 1.875rem; margin-right: var(--gap);
    display: flex; align-items: center; min-width: 0;
    background: var(--ink); color: var(--bg); border-radius: var(--r-sm);
    cursor: grab; user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; touch-action: pan-x pan-y;
  }
  .pl-bar .t { flex: 1; min-width: 0; padding: 0 0.5625rem; font: 400 0.8125rem/1 var(--font); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pl-bar .h { position: absolute; top: 0; bottom: 0; width: 0.625rem; cursor: ew-resize; z-index: 2; }
  .pl-bar .h::after { content: ""; position: absolute; top: 0.5rem; bottom: 0.5rem; width: 2px; background: var(--bg); opacity: 0; transition: opacity 120ms ease; }
  .pl-bar .h-l { left: 0; } .pl-bar .h-l::after { left: 0.1875rem; }
  .pl-bar .h-r { right: 0; } .pl-bar .h-r::after { right: 0.1875rem; }
  .pl-bar .x { flex: none; display: none; place-items: center; width: 1.5rem; height: 1.875rem; margin-right: 0.5rem; padding: 0; border: 0; background: none; color: var(--bg); font: 300 1.25rem/1 var(--font); cursor: pointer; opacity: 0.7; }
  .pl-bar .x:hover { opacity: 1; }
  @media (hover: hover) {
    .pl-bar:hover .h::after { opacity: 0.55; }
    .pl-bar:hover .x { display: grid; }
  }
  .pl-bar.is-selected .h::after { opacity: 0.55; }
  .pl-bar.is-selected .x { display: grid; }
  .pl-bar:focus-visible { outline-offset: 2px; }
  .pl-bar.is-placeholder, .pl-ghost {
    background: repeating-linear-gradient(135deg, transparent 0 0.375rem, rgba(10, 10, 10, 0.07) 0.375rem 0.4375rem);
    outline: 1px dashed var(--ink); outline-offset: -1px; cursor: grabbing;
  }
  .pl-bar.is-placeholder > * { visibility: hidden; }
  .pl-bar.is-placeholder.is-bin { opacity: 0.35; }
  .pl-ghost { height: 1.875rem; margin-right: var(--gap); border-radius: var(--r-sm); pointer-events: none; }
  /* поднятая плашка летит над страницей; теней на сайте нет — отрываем от сетки лёгким наклоном */
  .pl-lift { position: fixed; left: 0; top: 0; z-index: 85; margin: 0; pointer-events: none; transition: opacity 150ms ease; }
  .pl-lift .x, .pl-lift .h { display: none !important; }
  .pl-lift.is-bin { opacity: 0.45; }
  .pl-lift.is-land { transition: transform 220ms var(--ease-out), opacity 220ms var(--ease-out); }
  .pl-lift.is-drop { transition: transform 200ms var(--ease-out), opacity 200ms var(--ease-out); opacity: 0; }
  html.pl-grabbing, html.pl-grabbing * { cursor: grabbing !important; }

  .pl-bar.is-pop { transform-origin: 0 50%; animation: pl-pop 280ms var(--ease-out) backwards; }
  @keyframes pl-pop { from { transform: scaleX(0.2); opacity: 0; } }
  /* подрагивание — подсказка, что плашки можно тащить; у длинных амплитуда меньше */
  .pl-bar.is-wiggle { animation: pl-wiggle 500ms ease; }
  @keyframes pl-wiggle {
    20% { transform: rotate(calc(var(--amp) * -1)); }
    40% { transform: rotate(var(--amp)); }
    60% { transform: rotate(calc(var(--amp) * -0.6)); }
    80% { transform: rotate(calc(var(--amp) * 0.3)); }
  }

  .pl-drop .pl-name { color: var(--soft); }
  .pl-drop.is-target .pl-name { color: var(--ink); }
  .pl-slot { height: 1.875rem; margin-right: var(--gap); border: 1px dashed var(--soft); border-radius: var(--r-sm); background: none; color: var(--grey); font: 300 1.25rem/1 var(--font); cursor: pointer; padding: 0; }
  .pl-slot:hover { border-color: var(--ink); color: var(--ink); }
  .pl-cell, .pl-when, .pl-short { display: none; }

  .pl-float {
    position: fixed; left: 0; top: 0; z-index: 85; pointer-events: none;
    display: flex; align-items: center; height: 1.875rem; padding: 0 0.75rem;
    background: var(--ink); color: var(--bg); border-radius: var(--r-sm);
    font: 400 0.8125rem/1 var(--font); white-space: nowrap;
  }
  .pl-float.is-back { transition: transform 250ms var(--ease-out), opacity 250ms var(--ease-out); opacity: 0; }

  @media (max-width: 760px) {
    .pl-caption .pl-title { font-size: 1.0625rem; }
    .pl-drop { display: none; }
    .pl-row.pl-headrow { grid-template-rows: auto; min-height: 0; padding-bottom: 0.5rem; }
    .pl-row.pl-headrow > * { grid-row: 1; }
    .pl-row.pl-headrow > .pl-name { display: none; }
    .pl-month { margin-right: var(--gap); text-align: center; font-size: 0.6875rem; }
    .pl-long { display: none; }
    .pl-short { display: inline; }
    .pl-row { grid-template-rows: auto 1.375rem; height: auto; align-items: stretch; padding-bottom: 0.875rem; }
    .pl-row > * { grid-row: 2; }
    .pl-row > .pl-name { grid-row: 1; grid-column: 1 / -1; display: flex; justify-content: space-between; align-items: baseline; gap: 0.75rem; padding: 0.75rem 0 0.5rem; font: 400 0.875rem/1.2 var(--font); white-space: normal; }
    .pl-when { display: inline; flex: none; font: 400 0.75rem/1.2 var(--font); color: var(--grey); }
    /* ячейки месяцев на телефоне — радиус 4, как в Figma (в DESIGN.md токена нет) */
    .pl-cell { display: block; margin: 0 var(--gap) 0 0; padding: 0; border: 0; border-radius: 0.25rem; background: var(--cell-empty); cursor: pointer; }
    .pl-cell:active { background: #e2e2e2; }
    .pl-row.is-new, .pl-row.is-gone { height: 0; padding-bottom: 0; }
    .pl-bar, .pl-ghost, .pl-slot { height: 1.375rem; border-radius: 0.25rem; }
    .pl-bar { pointer-events: none; }
    .pl-bar > * { display: none; }
    .plan.is-folded .pl-row.is-extra { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pl-row, .pl-col-hl, .pl-chip, .pl-float.is-back, .pl-lift.is-land, .pl-lift.is-drop { transition: none; }
    .pl-bar.is-wiggle, .pl-bar.is-pop, .pl-restart.is-spin svg { animation: none; }
  }
</style>
