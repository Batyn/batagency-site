---
// Юридическая страница (Figma Final, секция Legal: десктоп A 361:5154 / 362:5297, телефон B 361:6468 / 362:6968).
// Десктоп: слева липкое оглавление (колонки 1–3), текст 648 в колонках 4–9. Телефон: оглавление списком сверху,
// таблицы — блоками «название — значение». Блока консультации нет.
import Breadcrumbs from './Breadcrumbs.astro';
import type { Legal } from '../lib/legal';
interface Props { doc: Legal }
const { doc } = Astro.props;
---
<Breadcrumbs current={doc.title} />
<div class="lg-head wrap">
  <div class="row">
    <div class="col-main">
      <h1 class="t-h-lg">{doc.title}</h1>
      <p class="lg-ed">{doc.edition}</p>
    </div>
  </div>
</div>
<div class="wrap"><div class="section-rule"></div></div>

<div class="lg wrap">
  <nav class="lg-toc" aria-labelledby="toc-h">
    <p class="lg-toc-h" id="toc-h">Содержание</p>
    <ol>
      {doc.toc.map((t) => <li><a href={`#${t.id}`}>{t.text}</a></li>)}
    </ol>
  </nav>
  <article class="lg-text">
    {doc.blocks.map((b) => {
      if (b.t === 'h2') return <h2 id={b.id}>{b.text}</h2>;
      if (b.t === 'h3') return <h3 id={b.id}>{b.text}</h3>;
      if (b.t === 'p') return <p set:html={b.html} />;
      if (b.t === 'ul') return <ul>{b.items.map((i) => <li set:html={i} />)}</ul>;
      if (b.t === 'table') {
        const keyValue = b.head.every((h) => !h);
        return (
          <table class:list={{ 'is-kv': keyValue }}>
            {!keyValue && <thead><tr>{b.head.map((h) => <th scope="col" set:html={h} />)}</tr></thead>}
            <tbody>
              {b.rows.map((r) => (
                <tr>{r.map((c, i) => i === 0
                  ? <th scope="row" data-label={keyValue ? '' : b.head[i].replace(/<[^>]+>/g, '')} set:html={c} />
                  : <td data-label={keyValue ? '' : b.head[i].replace(/<[^>]+>/g, '')} set:html={c} />)}</tr>
              ))}
            </tbody>
          </table>
        );
      }
      if (b.t === 'recipient') return (
        <section class="lg-rcp">
          <h3>{b.title}</h3>
          <dl>{b.rows.map(([k, v]) => <div><dt set:html={k} /><dd set:html={v} /></div>)}</dl>
        </section>
      );
    })}
  </article>
</div>

<style>
  /* только сверху и снизу: боковые поля даёт .wrap (из-за padding: … 0 … текст на телефоне стоял у края, баг 27) */
  .lg-head { padding-block: 3.5rem; }
  .lg-head .col-main > * + * { margin-top: 1.25rem; }
  .lg-ed { font: 400 0.9375rem/1.3 var(--font); color: var(--grey); }

  .lg { display: grid; grid-template-columns: var(--col-3) minmax(0, 40.5rem); column-gap: var(--col-gap); padding-top: 3.5rem; padding-bottom: var(--section-bottom); }
  .lg-toc { position: sticky; top: calc(var(--header-h) + 1.5rem); align-self: start; max-height: calc(100vh - var(--header-h) - 3rem); overflow: auto; }
  .lg-toc-h { font: 400 0.8125rem/1.2 var(--font); color: var(--grey); margin-bottom: 0.75rem; }
  .lg-toc ol { display: flex; flex-direction: column; gap: 0.375rem; }
  /* Figma «TOC item» (403:5892): наведение и текущий раздел — чёрная плашка, белый текст, радиус 6, как текущий пункт меню */
  .lg-toc a {
    display: block; padding: 0.1875rem 0.5rem; border-radius: var(--r-sm);
    font: 400 0.9375rem/1.45 var(--font);
    transition: background-color 160ms ease, color 160ms ease;
  }
  .lg-toc a.is-current { background: var(--ink); color: var(--bg); }
  @media (hover: hover) and (pointer: fine) { .lg-toc a:hover { background: var(--ink); color: var(--bg); } }

  .lg-text { font: 400 1rem/1.5 var(--font); }
  .lg-text > :first-child { margin-top: 0; }
  .lg-text :global(p) { margin-bottom: 1rem; }
  .lg-text h2 { font: 500 1.625rem/1.2 var(--font); margin: 2rem 0 1rem; }
  .lg-text h3 { font: 500 1.25rem/1.3 var(--font); margin: 1rem 0 0.75rem; }
  .lg-text ul { margin-bottom: 1rem; display: flex; flex-direction: column; gap: 0.5rem; }
  .lg-text ul li { position: relative; padding-left: 1.25rem; }
  .lg-text ul li::before { content: "•"; position: absolute; left: 0; }
  .lg-text :global(a) { text-decoration: underline; text-underline-offset: 0.1875rem; text-decoration-thickness: 1px; overflow-wrap: anywhere; }
  .lg-text :global(code) { font: 500 0.9375rem/1.45 var(--font); }
  .lg-text :global(strong) { font-weight: 500; }

  table { width: 100%; border-collapse: collapse; margin: 0.5rem 0 1.5rem; font: 400 0.9375rem/1.45 var(--font); }
  th, td { overflow-wrap: anywhere; text-align: left; vertical-align: top; padding: 0.75rem 1rem 0.75rem 0; border-top: 1px solid var(--ink); }
  tbody tr:last-child > * { border-bottom: 1px solid var(--ink); }
  thead th { font-weight: 500; }
  tbody th { font-weight: 500; width: 32%; }
  .is-kv tbody th { font-weight: 400; color: var(--grey); }

  .lg-rcp h3 { margin-top: 1rem; }
  .lg-rcp dl { margin: 0 0 1rem; border-top: 1px solid var(--hairline); }
  .lg-rcp dl > div { padding: 0.75rem 0; border-bottom: 1px solid var(--hairline); font: 400 0.9375rem/1.45 var(--font); }
  .lg-rcp dt { color: var(--grey); }
  .lg-rcp dd { margin: 0.25rem 0 0; }

  @media (prefers-reduced-motion: reduce) { .lg-toc a { transition: none; } }
  @media (max-width: 760px) {
    .lg-head { padding-block: 2rem 1.75rem; }
    /* «конфиденциальности» одним словом шире колонки 320 на 360 px: заголовок уменьшается вместе с экраном, до 34 */
    .lg-head h1 { font-size: min(2.125rem, calc((100vw - 2.5rem) / 10.6)); }
    .lg-head .col-main > * + * { margin-top: 0.75rem; }
    .lg-ed { font-size: 0.8125rem; }
    .lg { grid-template-columns: 1fr; padding-top: 1.5rem; }
    .lg-toc { position: static; max-height: none; margin-bottom: 2rem; }
    .lg-toc ol { gap: 0; border-top: 1px solid var(--hairline); }
    .lg-toc li { border-bottom: 1px solid var(--hairline); }
    .lg-toc a { display: flex; align-items: center; min-height: 2.75rem; font-size: 1rem; padding: 0.625rem 0.5rem; }
    /* телефон: при нажатии — та же инверсия */
    .lg-toc a:active { background: var(--ink); color: var(--bg); }
    .lg-text { line-height: 1.45; }
    .lg-text h2 { font: 700 1.25rem/1.04 var(--font); letter-spacing: -0.01em; margin: 2rem 0 0.875rem; }
    .lg-text h3 { font: 500 1.0625rem/1.2 var(--font); }
    /* таблицы на телефоне — блоками «название — значение», без прокрутки */
    table, tbody, tr, th, td { display: block; width: auto; }
    thead { display: none; }
    tbody tr { padding: 0.75rem 0; border-top: 1px solid var(--hairline); }
    tbody tr:last-child { border-bottom: 1px solid var(--hairline); }
    th, td, tbody tr:last-child > * { border: 0; padding: 0; }
    tbody th { width: auto; font-weight: 500; }
    td { margin-top: 0.25rem; }
    td[data-label]:not([data-label=""])::before { content: attr(data-label) " — "; color: var(--grey); }
  }
</style>

<script>
  // подсветка текущего раздела в оглавлении
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.lg-toc a')];
  const map = new Map(links.map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
  if ('IntersectionObserver' in window && matchMedia('(min-width: 761px)').matches) {
    const io = new IntersectionObserver((es) => {
      es.forEach((e) => {
        if (!e.isIntersecting) return;
        links.forEach((a) => { a.classList.remove('is-current'); a.removeAttribute('aria-current'); });
        const cur = map.get(e.target.id);
        cur?.classList.add('is-current');
        cur?.setAttribute('aria-current', 'location');
      });
    }, { rootMargin: '0px 0px -70% 0px' });
    map.forEach((_, id) => { const h = document.getElementById(id); if (h) io.observe(h); });
  }
</script>
