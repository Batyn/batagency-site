---
// Кнопка темы «Терминал» в шапке (Batın 2026-10-23): сайт становится маркдаун-документом на зелёном мониторе IBM
// (styles/term.css). Значок — пиксельный «>_», включённое состояние — инверсия. Без JS кнопки нет: тема только улучшение.
---
<button class="tt" type="button" data-theme-toggle aria-pressed="false" aria-label="Режим терминала" title="Режим терминала">
  <svg viewBox="0 0 10 7" width="20" height="14" aria-hidden="true" focusable="false" shape-rendering="crispEdges">
    <path d="M1 1h2v1h-2zM2 2h2v1h-2zM3 3h2v1h-2zM2 4h2v1h-2zM1 5h2v1h-2zM5 5h4v1h-4z" fill="currentColor" />
  </svg>
</button>

<script>
  import '../scripts/theme';
</script>

<style>
  /* зона нажатия 44×44, а плашка наведения и включённого состояния — 28×24, по высоте как плашка текущего пункта меню
     (Batın 2026-10-24: «квадратик слишком большой») */
  .tt {
    position: relative;
    display: none;
    place-items: center; width: 2.75rem; height: 2.75rem; padding: 0;
    background: transparent; border: 0; cursor: pointer;
    transition: color 160ms ease;
  }
  .tt::before {
    content: ""; position: absolute; inset: 0.625rem 0.5rem;
    border-radius: var(--r-sm); background: transparent;
    transition: background-color 160ms ease;
  }
  .tt svg { position: relative; }
  :global(.js) .tt { display: grid; }
  .tt svg { width: 1.25rem; height: auto; }
  .tt[aria-pressed="true"] { color: var(--bg); }
  .tt[aria-pressed="true"]::before { background: var(--ink); }
  @media (hover: hover) and (pointer: fine) {
    .tt:hover { color: var(--bg); }
    .tt:hover::before { background: var(--ink); }
  }
  @media (max-width: 760px) {
    /* рядом с «Меню»: прижимается вправо к бургеру */
    .tt { margin: -0.1875rem 0.25rem -0.1875rem auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tt, .tt::before { transition: none; }
  }
</style>
