---
// Первый экран главной (Figma Final, «1 · Первый экран», 278:4646 / 278:5094; шапка — Components «Header · desktop»).
// Десктоп 1440×900: логотип 246×122 слева сверху, меню справа, заголовок display на две строки,
// внизу подзаголовок слева; кнопки «Бесплатная консультация» на первом экране нет — вместо неё сразу видна липкая
// «Оставить заявку» (Batın 2026-10-13). При прокрутке шапка липкая: логотип уменьшается до 81×40
// (как на внутренних страницах), фон становится матовым стеклом (Figma «Header · scroll», 411:14050).
// Телефон: логотип 76×38, «Меню», заголовок 40, внизу текст; шапка не липкая.
import Logo from './Logo.astro';
import MenuButton from './MenuButton.astro';
import Snake from './Snake.astro';
import { NAV } from '../data/site';

// вариант B (Figma «Home hero · Apple variants», 603:9067 / 603:9176; задача 87, проба): под заголовком лид 26 в два тона —
// весь чёрным (до 2026-10-23 продолжение было серым); змейка справа от лида, внизу пусто
interface Props { variant?: 'b' }
const { variant } = Astro.props;
const b = variant === 'b';

// на главной пункты-якоря ведут к блокам этой же страницы
const nav = NAV.map((n) => ({ ...n, href: n.key === 'kak-rabotaem' || n.key === 'kontakty' ? `#${n.key}` : n.href }));
---
<header class:list={['hero wrap', { 'hero--b': b }]} id="top">
  <div class="hero-bar" data-bar>
    <span class="glass" data-bar-glass aria-hidden="true"></span>
    <div class="hero-top wrap">
      <a class="hero-logo" href="/" aria-label="Bat Agency — на главную" data-bar-logo><Logo /></a>
      <nav class="nav" aria-label="Разделы" data-bar-nav>
        {nav.map((n) => <a class="nav-a t-label-md" href={n.href}>{n.label}</a>)}
      </nav>
      <MenuButton />
    </div>
  </div>
  <div class="hero-space" aria-hidden="true"></div>
  <h1 class="hero-title t-display">Маркетинг и PR для <span class="nowrap">дизайн‑ и</span> digital-агентств</h1>
  {b && <p class="hero-lead t-lead">Вы делаете проекты, мы рассказываем о них клиентам, жюри и отраслевым СМИ. Пишем кейсы и заявки на премии, ведём соцсети и рассылку, готовим спикеров и вебинары.</p>}
  <Snake />
  {!b && <div class="hero-bottom">
    <p class="hero-sub t-body-sm">Вы делаете проекты, мы рассказываем о них клиентам, жюри и отраслевым СМИ. Пишем кейсы и заявки на премии, ведём соцсети и рассылку, готовим спикеров и вебинары.</p>
  </div>}
</header>

<script>
  import '../scripts/eye';

  // Змейка (кнопка и игра) — отдельный чанк после загрузки страницы: в бюджет JS первого экрана не входит
  const snake = document.querySelector<HTMLElement>('[data-snake]');
  if (snake) {
    const start = () => import('../scripts/snake').then((m) => m.init(snake));
    const idle = () => ('requestIdleCallback' in window ? requestIdleCallback(start, { timeout: 2000 }) : setTimeout(start, 200));
    if (document.readyState === 'complete') idle(); else addEventListener('load', idle, { once: true });
  }

  // Шапка на десктопе: первые 120 px прокрутки логотип плавно уменьшается из 246×122 в 81×40 и встаёт в шапку 68,
  // меню поднимается к середине шапки, проступает стекло. Ход привязан к прокрутке 1:1 — только transform и opacity.
  // При reduced-motion без промежуточных кадров: вверху — большой логотип, после первого пикселя — сразу компактная шапка.
  // Ниже начала первого блока после первого экрана шапка уезжает вверх при прокрутке вниз и возвращается при прокрутке вверх
  // (Batın 2026-10-09; с 2026-10-20 первый блок — описание, а не «Услуги»).
  // Телефон: шапка «bat + Меню» прячется, как только её прокрутили, и появляется при прокрутке вверх.
  import { autoHide } from '../scripts/autohide';
  const DIST = 120;
  const SCALE = 81 / 246;
  const desk = matchMedia('(min-width: 761px)');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const logo = document.querySelector<HTMLElement>('[data-bar-logo]')!;
  const nav = document.querySelector<HTMLElement>('[data-bar-nav]')!;
  const glass = document.querySelector<HTMLElement>('[data-bar-glass]')!;
  const bar = document.querySelector<HTMLElement>('[data-bar]')!;
  const firstBlock = document.querySelector<HTMLElement>('main > :first-child');
  let rem = 16, navLift = 0, queued = false;
  const hide = autoHide(bar, () => desk.matches
    ? (firstBlock ? firstBlock.getBoundingClientRect().top + scrollY - bar.offsetHeight : Infinity)
    : bar.offsetHeight);

  function measure() {
    rem = parseFloat(getComputedStyle(document.documentElement).fontSize);
    // в большом виде меню стоит вровень с верхом логотипа (y = 44), в шапке — по её середине
    navLift = 2.75 * rem - nav.offsetTop;
  }

  function render() {
    queued = false;
    const y = Math.max(0, scrollY);
    hide(y);
    if (!desk.matches) { logo.style.transform = nav.style.transform = ''; glass.style.opacity = y > 0 ? '1' : '0'; return; }
    const p = reduced.matches ? (y > 0 ? 1 : 0) : Math.min(1, y / DIST);
    // из точки (0, 44) от поля в (0, 14): логотип на поле и в большом виде (выравнивание отступов, Batın 2026-10-15)
    logo.style.transform = `translateY(${(-1.875 * rem * p).toFixed(2)}px) scale(${(1 - (1 - SCALE) * p).toFixed(4)})`;
    nav.style.transform = `translateY(${(navLift * (1 - p)).toFixed(2)}px)`;
    glass.style.opacity = String(p);
  }
  const queue = () => { if (!queued) { queued = true; requestAnimationFrame(render); } };

  measure(); render();
  addEventListener('scroll', queue, { passive: true });
  addEventListener('resize', () => { measure(); queue(); });
  desk.addEventListener('change', () => { measure(); queue(); });
  reduced.addEventListener('change', queue);
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto 1fr auto;
    min-height: max(40rem, min(100svh, 56.25rem));
    /* низ подзаголовка в 24 от низа экрана, вровень с липкой «Оставить заявку» (Batın 2026-10-15) */
    padding-top: 2.75rem; padding-bottom: var(--s-2xl);
  }
  /* место большого логотипа в сетке: сама шапка вынесена из потока */
  .hero-space { height: 7.625rem; }

  /* без JS шапка уезжает вместе с первым экраном; с JS — липкая */
  .hero-bar { position: absolute; top: 0; left: 0; right: 0; z-index: 60; height: var(--header-h); }
  :global(.js) .hero-bar { position: fixed; }
  .hero-bar .glass { transition: none; }
  /* шапка уезжает и возвращается целиком, 300 мс, кривая выезжающей панели iOS */
  .hero-bar { transition: transform var(--t-header) var(--ease-drawer); }
  .hero-bar.is-hidden { transform: translateY(-100%); transition-duration: var(--t-header-out); transition-timing-function: var(--ease-in-out); }
  .hero-top { position: relative; height: 100%; display: flex; justify-content: flex-end; align-items: center; }
  /* логотип на поле 60, как заголовок (Batın 2026-10-15; до этого стоял на 7 px правее — компенсация круглой «b») */
  .hero-logo {
    position: absolute; left: var(--gutter); top: 2.75rem;
    display: block; width: 15.375rem;
    transform-origin: 0 0;
  }
  .hero-logo :global(svg) { width: 100%; height: auto; }
  .nav { display: flex; align-items: center; gap: 1.75rem; }
  .nav-a { padding: 0.1875rem 0.5rem; margin: -0.1875rem -0.5rem; border-radius: var(--r-sm); }
  @media (hover: hover) and (pointer: fine) {
    .nav-a:hover { text-decoration: underline; text-underline-offset: 0.25rem; }
  }
  .hero-title { grid-row: 3; grid-column: 1; max-width: 68.75rem; text-wrap: balance; transition: transform 500ms var(--ease-in-out); }
  /* открыта змейка: заголовок уезжает вверх и освобождает место под игру (--snake-shift — scripts/snake.ts) */
  .hero.is-game .hero-title { transform: translateY(calc(-1 * var(--snake-shift, 0px))); }
  .hero-bottom { grid-row: 5; grid-column: 1; display: flex; justify-content: space-between; align-items: flex-end; gap: 1.5rem; }
  .hero-sub { max-width: 29.75rem; }

  /* B: лид в колонках 1–7 (47,5rem) сразу под заголовком; в игре на десктопе стоит на месте — вверх уезжает только
     заголовок, без уменьшения (Batın 2026-10-23: уменьшение заголовка и лида отменено) */
  .hero-lead {
    grid-row: 4; grid-column: 1; align-self: start;
    max-width: 47.5rem; margin-top: var(--s-5xl);
    text-wrap: pretty;
    transition: transform 500ms var(--ease-in-out);
  }
  /* змейка справа от лида, а не от короткого подзаголовка: лид 47,5rem + зазор 2rem */
  .hero--b :global(.snake) { width: max(0px, min(36rem, 100% - 49.5rem)); }
  /* на 761–~1100 места нет и игра скрыта (is-small), но подсказка с отступом под круг вылезала за край — горизонтальная
     прокрутка. Только десктоп: на телефоне обрезка срезала слой свайпа до размера поля */
  @media (min-width: 761px) { .hero--b :global(.snake-play) { overflow: hidden; } }

  @media (max-width: 760px) {
    .hero {
      grid-template-rows: auto auto 1fr auto;
      min-height: 100svh;
      padding-top: 0; padding-bottom: clamp(3rem, 18svh, 9.5rem);
    }
    .nav { display: none; }
    /* шапка 62: отступы 16 и 8, логотип 76×38; место под ней держит .hero-space */
    .hero-space { height: 3.875rem; }
    .hero-bar { height: auto; }
    .hero-top { padding-top: 1rem; padding-bottom: 0.5rem; justify-content: space-between; }
    .hero-logo { position: static; width: 4.75rem; margin: -0.1875rem 0; padding: 0.1875rem 0; }
    .hero-title { grid-row: 2; margin-top: 4.375rem; }
    .hero-bottom { grid-row: 4; flex-direction: column; align-items: stretch; gap: 1rem; padding-top: 2.5rem; }
    /* B: заголовок, лид, под ними змейка на остаток экрана */
    .hero--b { grid-template-rows: auto auto auto 1fr; }
    .hero-lead { grid-row: 3; margin-top: var(--s-2xl); }
    /* на телефоне поле под лидом: лид уезжает вверх вместе с заголовком, иначе игре мало места */
    .hero.is-game .hero-lead { transform: translateY(calc(-1 * var(--snake-shift, 0px))); }
    .hero--b :global(.snake) { grid-row: 4; width: auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-bar, .hero-title, .hero-lead { transition: none; }
  }
</style>
