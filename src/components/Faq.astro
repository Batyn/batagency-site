---
// Частые вопросы (Figma Components «FAQ row», 402:13951): аккордеон по логике строк «Услуг» — рамка 1 px, радиус 8,
// справа «+» / «−», можно раскрыть несколько, 0,3 с. Раскрытая строка остаётся белой, как в макете.
// Первый вопрос открыт сразу, чтобы было видно, что строки раскрываются (Batın 2026-10-09).
// На <details>: без JS тоже раскрывается, весь текст в HTML. Список — data/faq.ts.
import { FAQ } from '../data/faq';
---
<section class="faq wrap section" id="voprosy" aria-labelledby="faq-h">
  <div class="faq-grid">
    <h2 class="faq-label t-label-md" id="faq-h">Частые вопросы</h2>
    <div class="faq-list" data-accordion="faq_open">
      {FAQ.map((f, i) => (
        <details class="faq-row" open={i === 0}>
          <summary class="faq-q">
            <h3 class="faq-q-text">{f.q}</h3>
            <span class="faq-sign" aria-hidden="true"></span>
          </summary>
          <div class="acc-body faq-a"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  import '../scripts/accordion';
</script>

<style>
  .faq { margin-top: 4.5rem; }
  .faq-grid { display: grid; grid-template-columns: var(--col-3) minmax(0, 1fr); column-gap: var(--col-gap); }
  .faq-list { display: flex; flex-direction: column; gap: 0.5rem; }
  .faq-row { border: 1px solid var(--ink); border-radius: var(--r-md); overflow: hidden; }
  .faq-q { display: flex; align-items: center; gap: 1.5rem; padding: 1.25rem; cursor: pointer; list-style: none; }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-q:focus-visible { outline-offset: -0.25rem; }
  .faq-q-text { flex: 1 1 auto; font: 500 1.25rem/1.3 var(--font); }
  /* «+» и «−» одним знаком, как у строк «Услуг»: вертикальная черта сворачивается */
  .faq-sign { position: relative; flex: none; width: 1.375rem; height: 1.375rem; }
  .faq-sign::before, .faq-sign::after { content: ""; position: absolute; left: 0; right: 0; top: 50%; height: 0.1875rem; margin-top: -1.5px; background: currentColor; }
  .faq-sign::after { transform: rotate(90deg); transition: transform var(--t-accordion) var(--ease-out); }
  .faq-row[open] .faq-sign::after { transform: rotate(0deg) scaleX(0); }
  .faq-row.is-closing .faq-sign::after { transform: rotate(90deg); }
  /* между вопросом и ответом 16, снизу 32 */
  .faq-a { margin-top: -0.25rem; padding: 0 1.25rem 2rem; font: 400 1.125rem/1.45 var(--font); }

  @media (max-width: 760px) {
    .faq { margin-top: 2rem; }
    .faq-grid { grid-template-columns: 1fr; row-gap: 0.75rem; }
    .faq-label { font: 400 0.8125rem/1.2 var(--font); }
    .faq-q { padding: 1.125rem 1rem; }
    .faq-q-text { font-size: 1.0625rem; line-height: 1.2; }
    .faq-sign { width: 0.875rem; height: 0.875rem; }
    .faq-sign::before, .faq-sign::after { height: 2px; margin-top: -1px; }
    .faq-a { margin-top: -0.375rem; padding: 0 1rem 1.5rem; font-size: 1rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-sign::after { transition: none; }
  }
</style>
