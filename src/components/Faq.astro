---
// Частые вопросы (Figma Final, часть «5 · Консультация и ответы»). В макете ответы открыты сразу —
// так и верстаем; текст в HTML, JS не нужен. Список — data/faq.ts.
import { FAQ } from '../data/faq';
---
<section class="faq wrap section" id="voprosy" aria-labelledby="faq-h">
  <div class="faq-grid">
    <h2 class="faq-label t-label-md" id="faq-h">Частые вопросы</h2>
    <dl class="faq-list">
      {FAQ.map((f) => (
        <div class="faq-row">
          <dt class="faq-q">{f.q}</dt>
          <dd class="faq-a">{f.a}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .faq { margin-top: 4.5rem; }
  .faq-grid { display: grid; grid-template-columns: var(--col-3) minmax(0, 1fr); column-gap: var(--col-gap); }
  .faq-row {
    display: grid; grid-template-columns: minmax(0, 312fr) minmax(0, 536fr) minmax(0, 88fr); column-gap: var(--col-gap);
    padding: 1.25rem 0 2rem; border-top: 1px solid var(--ink);
  }
  /* внутри 984: вопрос 312, ответ 536, остаток пустой */
  .faq-q { font: 500 1.25rem/1.3 var(--font); }
  .faq-a { margin: 0; font: 400 1.125rem/1.45 var(--font); }

  @media (max-width: 760px) {
    .faq { margin-top: 2rem; }
    .faq-grid { grid-template-columns: 1fr; row-gap: 0.75rem; }
    .faq-label { font: 400 0.8125rem/1.2 var(--font); }
    .faq-row { grid-template-columns: 1fr; row-gap: 0.5rem; padding: 1.0625rem 0 1.25rem; }
    .faq-q { font-size: 1.0625rem; line-height: 1.2; }
    .faq-a { font-size: 0.9375rem; }
  }
</style>
