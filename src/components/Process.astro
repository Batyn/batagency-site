---
// «Как работаем» (Figma Final «3 · Как работаем» 278:4774 / 278:5199). Тексты — content/site-texts.md, раздел 4.
const STEPS = [
  { t: 'Консультация', d: 'Бесплатно смотрим, что у агентства уже есть: сайт, кейсы, премии, публикации, соцсети.' },
  { t: 'План', d: 'Присылаем работы, сроки и цены на одну задачу или на полгода. Начинаем после вашего «да».' },
  { t: 'Работа', d: 'Пишем тексты и заявки, ведём каналы. Каждый материал согласуем до публикации, деньги на рекламу и взносы тратим только на согласованную цель.' },
  { t: 'Отчёт', d: 'Раз в месяц рассказываем, что сделано и что изменилось в обращениях и охватах.' },
];
---
<section class="proc wrap section" id="kak-rabotaem" aria-labelledby="proc-h">
  <div class="section-rule"></div>
  <div class="section-head">
    <div class="row"><div class="col-main"><h2 class="t-h-lg" id="proc-h">Как работаем</h2></div></div>
  </div>
  <ol class="steps">
    {STEPS.map((s, i) => (
      <li class="step">
        <span class="step-n" aria-hidden="true">{i + 1}</span>
        <div class="step-body">
          <h3 class="step-t">{s.t}</h3>
          <p class="step-d">{s.d}</p>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .steps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: var(--col-gap); margin-top: 4.5rem; }
  .step { display: flex; flex-direction: column; gap: 0.875rem; border-top: 1px solid var(--ink); padding-top: 0.875rem; }
  .step-n { font: 700 4rem/1 var(--font); letter-spacing: -0.03em; }
  .step-body { display: flex; flex-direction: column; gap: 0.875rem; }
  .step-t { font: 700 1.375rem/1.2 var(--font); }
  .step-d { font: 400 1rem/1.5 var(--font); color: var(--grey); }

  @media (max-width: 760px) {
    .steps { grid-template-columns: 1fr; row-gap: 1.5rem; margin-top: 2rem; }
    .step { flex-direction: row; gap: 0.625rem; padding-top: 0.75rem; }
    .step-n { flex: 0 0 5rem; font: 500 2rem/1 var(--font); letter-spacing: 0; }
    .step-body { gap: 0.375rem; }
    .step-t { font: 500 1.125rem/1.2 var(--font); }
    .step-d { font-size: 0.9375rem; line-height: 1.45; }
  }
</style>
